# https://github.com/aspect-build/rules_js/issues/1408
startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1

common --enable_platform_specific_config

# TODO: remove once issues with yanked versions are resolved
common --allow_yanked_versions=rules_cc@0.1.0

coverage --experimental_ui_max_stdouterr_bytes=10485760

common:macos --linkopt=-L/opt/homebrew/lib

# Ensure GCC is used consistently for toolchain detection and compilation on Linux.
# This prevents a mismatch where local_config_cc detects one GCC version but compilation
# pulls headers from another, causing "absolute path inclusion" errors in Bazel's
# strict include checker (seen on Ubuntu 24.04 with rules_cc 0.2.x / Bazel 8.5+).
build:linux --repo_env=CC=gcc
build:linux --repo_env=CXX=g++

# disables telemetry https://github.com/aspect-build/tools_telemetry
common --repo_env=ASPECT_TOOLS_TELEMETRY=

# Release config for the SHIPPED iOS xcframework (the Kotelberg/maplibre-spm artifact).
# Production binaries MUST be built with this so MapLibre's diagnostic assertions are compiled out
# and the render path DEGRADES GRACEFULLY instead of SIGABRT'ing on-device. The default fastbuild
# leaves both kinds of assertion live, which is why fork builds aborted where official (Release)
# MapLibre does not:
#   - compilation_mode=opt defines NDEBUG  -> kills C assert() (e.g. mtl Texture2D::bind
#     assert(!textureDirty); mtl::Context::createProgram assert(false) on shader-compile failure)
#   - NS_BLOCK_ASSERTIONS kills Obj-C NSAssert / MLNAssert (e.g. -[MLNMapView annotationTagAtPoint:])
# Build the framework with:
#   bazel build --config=release //platform/ios:MapLibre.dynamic --//:renderer=metal
build:release --compilation_mode=opt
build:release --copt=-DNS_BLOCK_ASSERTIONS=1
build:release --objccopt=-DNS_BLOCK_ASSERTIONS=1
